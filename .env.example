# Token from @BotFather (keep it secret, never commit .env)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bot username without @, used to build the QR deep links
BOT_USERNAME=bmtm_feedback_bot

# Long random string. Used to make the once-per-day spam check anonymous.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
ANON_SALT=change-me

# SQLite by default. For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/feedback
DATABASE_URL=sqlite+aiosqlite:///data/feedback.db

TIMEZONE=Asia/Tashkent

# ---- Management dashboard ----
# Logins for the dashboard, comma separated  name:password
DASHBOARD_USERS=director:change-this-password,quality:another-password
# Another long random string (keeps dashboard logins secure)
DASHBOARD_SECRET=change-me-too

# ---- Telegram alerts for management ----
# ID of the management Telegram group that receives alerts (see README).
# Leave empty to turn alerts off.
ALERT_CHAT_ID=
